# Ignore Node.js dependencies
node_modules/

# Ignore environment files
*.env
*.env.example

# Ignore logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build outputs
dist/
build/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore editor/IDE files
.vscode/
.idea/
*.swp

# Ignore Docker intermediate files
**/.dockerignore
**/Dockerfile

# Optional: Ignore lock files (if you don’t want to track them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
